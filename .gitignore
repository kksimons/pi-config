# Sensitive files
auth.json
*.pem
*.key

# Session data (ephemeral, large)
sessions/

# Binaries and temp files
bin/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~

# Node modules (if any local packages)
node_modules/

# Derived/cached state (regenerated by pi)
models-store.json

# npm install dir (managed by pi)
npm/

# Machine-local state
trust.json

# Private project memory (per-project context, machine-specific)
memory/

# Machine-local extension config (maps absolute paths to private repos)
extensions/project-memory/config.json

# Externally-installed managed skill (symlink into ~/.agents, installed via skill manager)
skills/react-native-best-practices
